{
  "name": "pagina-infoservi-os",
  "version": "1.0.0",
  "private": true,
  "description": "Site institucional da Infoservicos Tecnologias - site estatico no Cloudflare Workers",
"scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "dev:painel": "wrangler dev -c painel/wrangler.toml",
    "deploy:painel": "wrangler deploy -c painel/wrangler.toml",
    "tail:painel": "wrangler tail -c painel/wrangler.toml"
  },
  "devDependencies": {
    "wrangler": "^4"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260930.2": true
  }
}
